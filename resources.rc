#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "generated\\RadxaControlCenter.ico"

1 VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Radxa Computer Co., Ltd."
            VALUE "FileDescription", "Radxa Control Center"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "RadxaControlCenter"
            VALUE "LegalCopyright", "Copyright (c) 2026 Radxa Computer Co., Ltd."
            VALUE "OriginalFilename", "RadxaControlCenter.exe"
            VALUE "ProductName", "Radxa Control Center"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

